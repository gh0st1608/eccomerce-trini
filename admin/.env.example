PORT=3001
NODE_ENV=development
APP_NAME=admin-trini-backend
APP_VERSION=1.0.0
LOG_LEVEL=info
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
PRODUCT_IMAGE_STORAGE_ENABLED=false
S3_BUCKET_NAME=
S3_BUCKET_PUBLIC_BASE_URL=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
PERSISTENCE_DRIVER=memory
DYNAMODB_ENDPOINT=
DYNAMODB_TABLE_PRODUCTS=
DYNAMODB_TABLE_CATEGORIES=
DYNAMODB_TABLE_STORES=
DYNAMODB_TABLE_INTERNAL_USERS=
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=admin-trini-backend
OTEL_SERVICE_NAME=admin-trini-backend
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.nr-data.net
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=development
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
JWT_SECRET=replace_me
JWT_EXPIRES=1h
ADMIN_AUTH_USERNAME=admin
ADMIN_AUTH_PASSWORD=admin123
ADMIN_AUTH_TOKEN=trini-admin-local-token
DATABASE_URL=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4173
CORS_ALLOWED_ORIGIN_PATTERNS=
CORS_ALLOW_NGROK=false
CORS_ALLOW_PRIVATE_NETWORK=false
REQUEST_TIMEOUT=10000
REQUEST_BODY_LIMIT=5mb
ENABLE_SWAGGER=false
ENABLE_METRICS=true
ENABLE_TRACING=true
ENABLE_LOGGING=true

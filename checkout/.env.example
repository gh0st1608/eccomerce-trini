PORT=3000
NODE_ENV=development
APP_NAME=ecommerce-trini-backend
APP_VERSION=1.0.0
LOG_LEVEL=info
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=ecommerce-trini-backend
OTEL_SERVICE_NAME=ecommerce-trini-backend
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.nr-data.net
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=development
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
JWT_SECRET=replace_me
JWT_EXPIRES=1h
DATABASE_URL=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOWED_ORIGIN_PATTERNS=
CORS_ALLOW_NGROK=false
CORS_ALLOW_PRIVATE_NETWORK=false
REQUEST_TIMEOUT=10000
REQUEST_BODY_LIMIT=5mb
CHECKOUT_SHARE_PUBLIC_BASE_URL=http://localhost:8080
LNKUA_API_BASE_URL=https://lnk.ua
LNKUA_SHORTENER_PATH=/api/v1/link/create
LNKUA_BEARER_TOKEN=public
LNKUA_REQUEST_TIMEOUT_MS=3500
ENABLE_SWAGGER=false
ENABLE_METRICS=true
ENABLE_TRACING=true
ENABLE_LOGGING=true
WHATSAPP_PHONE=51999999999
ADMIN_API_BASE_URL=http://localhost:3001/api/v1/admin
PUBLIC_API_TOKEN=trini-public-readonly-token

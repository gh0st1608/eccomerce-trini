VITE_APP_NAME=ecommerce-trini-frontend
VITE_ECOMMERCE_API_BASE_URL=/api/v1/checkout
VITE_ADMIN_API_BASE_URL=/api/v1/admin
# New Relic Browser (RUM) + distributed tracing. Leave empty to disable in local dev.
VITE_NEW_RELIC_BROWSER_ACCOUNT_ID=
VITE_NEW_RELIC_BROWSER_TRUST_KEY=
VITE_NEW_RELIC_BROWSER_AGENT_ID=
VITE_NEW_RELIC_BROWSER_LICENSE_KEY=
# Local host defaults. If frontend runs in Docker, override these values
# (for example with docker compose env vars) to reach backend containers.
VITE_DEV_PROXY_ECOMMERCE_TARGET=http://localhost:3000
VITE_DEV_PROXY_ADMIN_TARGET=http://localhost:3001
NGROK_AUTHTOKEN=

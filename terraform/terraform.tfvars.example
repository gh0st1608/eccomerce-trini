# Copy to terraform.tfvars (gitignored) and adjust. Safe defaults below target
# LocalStack, matching docker-compose.gateway.yml's local tokens/URLs.

project_name    = "trini"
environment     = "local"
aws_region      = "us-east-1"
use_localstack  = true
localstack_endpoint = "http://localhost:4566"

cors_allowed_origins           = "http://localhost:5173,http://localhost:8080"
checkout_share_public_base_url = "http://localhost:8080"

jwt_secret           = "local-development-secret-change-me"
admin_auth_username  = "admin"
admin_auth_password  = "admin123"
admin_auth_token     = "trini-admin-local-token"
public_api_token     = "trini-public-readonly-token"
admin_api_base_url   = "http://localhost:3001/api/v1/admin"
whatsapp_phone       = "51900000000"

# Leave empty locally; provide real values only for a production apply.
lnkua_bearer_token     = ""
new_relic_license_key  = ""
